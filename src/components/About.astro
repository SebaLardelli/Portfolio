---
const studies = [
  {
    title: "Tecnicatura en Desarrollo de Software",
    place: "Instituto Zona Oeste · 2023–2025",
  },
];
---

<section class="section" id="sobre-mi">
  <div class="container">
    <h2>Sobre mí</h2>
    <div class="prose">
      <p>
        Soy una persona trabajadora, organizada y responsable. Tengo experiencia en desarrollo de
        software, en proyectos de la facultad y en trabajos propios.
      </p>
      <p>Me considero una persona resolutiva, con buen ánimo y capaz de resolver problemas.</p>
    </div>

    <h3 class="subhead">Formación</h3>
    <ul class="studies">
      {
        studies.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.place}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
