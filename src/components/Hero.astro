---
import { profile } from "../data/profile";
import { publicUrl } from "../utils/publicUrl";
---

<section class="section hero" id="inicio">
  <div class="container">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-md-7">
        <p class="role">{profile.role}</p>
        <h1>{profile.name}</h1>
        <p class="lead">{profile.tagline}</p>
        <div class="actions">
          <a class="btn-signal" href="#proyectos">Ver proyectos</a>
          <a class="btn-ghost" href="#contacto">Contactarme</a>
          <a class="btn-ghost" href={publicUrl("cv.pdf")} download="Sebastian-Lardelli-CV.pdf">Descargar CV</a>
        </div>
      </div>
      <div class="col-md-5">
        <img
          class="portrait"
          src={publicUrl("sebastian-lardelli.png")}
          alt={profile.name}
          width="287"
          height="287"
        />
      </div>
    </div>
  </div>
</section>
